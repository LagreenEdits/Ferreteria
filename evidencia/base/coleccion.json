              "host": ["{{baseUrl}}"],
              "path": ["api", "proveedores"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Proveedor Postman\",\n  \"telefono\": \"3000000000\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('proveedorId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Asociar producto a proveedor (precio de compra 9000)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/proveedor-productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "proveedor-productos"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProveedor\": {{proveedorId}},\n  \"idProducto\": {{productoId}},\n  \"precioCompra\": 9000\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('asociacionId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Crear orden de compra (10 unidades)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/ordenes-compra",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ordenes-compra"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProveedor\": {{proveedorId}},\n  \"detalles\": [\n    { \"idProducto\": {{productoId}}, \"cantidad\": 10 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('ordenId', j.id);",
                  "pm.test('Queda PENDIENTE', () => pm.expect(j.estado).to.eql('PENDIENTE'));",
                  "pm.test('Total = 10 x 9000 (RN-03, RN-09)', () => pm.expect(Number(j.total)).to.eql(90000));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Recibir la orden (sube el stock)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ordenes-compra/{{ordenId}}/recibir",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ordenes-compra", "{{ordenId}}", "recibir"]
