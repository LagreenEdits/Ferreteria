{
  "info": {
    "name": "Xorr · Fases 0 y 1 (Inventario, Compras, Ventas y Seguridad)",
    "description": "Autenticación (registro y login con JWT), flujo principal (crear producto y proveedor, asociar, comprar, recibir, vender), reglas de negocio y protecciones (incluidos el límite estricto de stock bajo RN-04 y los valores negativos RN-07) y usuarios y roles (alta de empleados y 403 para EMPLEADO). Ejecutar con el Collection Runner en el orden en que aparecen. Requiere la aplicación arrancada en http://localhost:8081 (perfil dev). La carpeta 0 guarda el token del administrador y la carpeta 3 el del empleado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 · Autenticación",
      "item": [
        {
          "name": "0.1 Registrar administrador (empresa nueva)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('correoAdmin', 'postman' + Date.now() + '@correo.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Es ADMIN', () => pm.expect(j.rol).to.eql('ADMIN'));",
                  "pm.test('No devuelve la contraseña', () => pm.expect(JSON.stringify(j)).to.not.include('password'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro-admin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro-admin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreEmpresa\": \"Ferretería Postman\",\n  \"nombre\": \"Admin Postman\",\n  \"correo\": \"{{correoAdmin}}\",\n  \"password\": \"clave12345\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "0.2 Iniciar sesión (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Devuelve un token', () => pm.expect(j.token).to.be.a('string').and.not.empty);",
                  "pm.test('El usuario es ADMIN', () => pm.expect(j.usuario.rol).to.eql('ADMIN'));",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoAdmin}}\",\n  \"password\": \"clave12345\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "0.3 Sin token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('Pide iniciar sesión', () => pm.expect(pm.response.json().mensaje).to.include('iniciar sesión'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            }
          }
        }
      ]
    },
    {
      "name": "1 · Flujo principal",
      "item": [
        {
          "name": "1. Crear producto (stock 0)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Martillo Postman\",\n  \"precioVenta\": 15000,\n  \"stock\": 0,\n  \"stockMinimo\": 5\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('productoId', j.id);",
                  "pm.test('Guarda el id del producto', () => pm.expect(j.id).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Crear proveedor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
